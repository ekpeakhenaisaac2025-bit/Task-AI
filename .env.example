# ==============================================================================
# Task.ai — Server Environment Configuration
# Secrets are server-side only and are never exposed to the browser, AI prompts,
# error messages, or action logs.
# ==============================================================================

# [REQUIRED] GEMINI_API_KEY
# - Required: Yes (for AI Planner and built-in llm_reasoning tasks; automatically injected in AI Studio).
# - Expected format: Non-empty provider API key string.
# - How to generate: Provisioned automatically via AI Studio Secrets / Google AI Studio API Keys.
# - Safe to leave blank: No if using AI Planner or llm_reasoning (diagnostic & webhook workers still run).
# - Dependent features: AI Goal-to-Task Planner (/api/goals/:id/plan) and llm_reasoning execution provider.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# [PLATFORM-MANAGED] APP_URL
# - Required: Optional (automatically injected at runtime with the hosted service URL).
# - Expected format: HTTPS application origin URL.
# - Safe to leave blank: Yes in local development.
# - Dependent features: Self-referential service URL metadata.
APP_URL="MY_APP_URL"

# [PLATFORM-MANAGED] Managed PostgreSQL Connection Pool & Migration Variables
# Automatically injected by the Cloud SQL Auth Proxy runtime. Do not use DATABASE_URL.
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# [REQUIRED IN PRODUCTION] SESSION_HMAC_SECRET
# - Required: Yes in production (server refuses to start if missing or invalid).
# - Expected format: At least 64 hexadecimal characters (0-9, a-f), even length (>= 32 random bytes / 256 bits of entropy).
# - How to generate: openssl rand -hex 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# - Safe to leave blank: NEVER in production. In local development only, leaving blank uses a persistent 0600 local dev keyfile.
# - Dependent features: HMAC-SHA256 signing & verification of isolated workspace session cookies/tokens (taskai_session).
SESSION_HMAC_SECRET=""

# [REQUIRED IN PRODUCTION] INTEGRATION_ENCRYPTION_KEY
# - Required: Yes in production (server refuses to start if missing or invalid; never auto-replaced in production).
# - Expected format: Exact 64 hexadecimal characters (0-9, a-f) representing 32 random bytes (256 bits) for AES-256-GCM.
# - How to generate: openssl rand -hex 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# - Safe to leave blank: NEVER in production. Keep stable across restarts so stored integration credentials remain decryptable.
# - Dependent features: AES-256-GCM at-rest encryption and execution-time decryption of per-workspace webhook secrets & tokens.
INTEGRATION_ENCRYPTION_KEY=""

# [OPTIONAL] INTEGRATION_ENCRYPTION_KEY_PREVIOUS
# - Required: Optional (used only during encryption key rotation).
# - Expected format: Comma-separated list of previous 64-character hexadecimal AES-256-GCM keys, or empty string.
# - How to generate: Place your retiring 64-char hex INTEGRATION_ENCRYPTION_KEY here while migrating to a newly generated key.
# - Safe to leave blank: Yes (leave blank unless actively rotating INTEGRATION_ENCRYPTION_KEY).
# - Dependent features: Seamless decryption and re-encryption migration (/api/integrations/rotate-keys) of existing credentials.
INTEGRATION_ENCRYPTION_KEY_PREVIOUS=""

# [OPTIONAL] PLATFORM_SHARED_N8N_BASE_URL
# - Required: Optional (Task.ai runs completely without n8n).
# - Expected format: Public HTTPS origin URL (e.g., https://n8n.example.com) passing SSRF checks, or empty string.
# - How to generate: Provide the HTTPS origin of an administrator-managed shared n8n instance if hosting one.
# - Safe to leave blank: Yes. Users can always connect per-workspace Custom HTTPS Webhooks or user-owned n8n URLs without this.
# - Dependent features: Administrator-managed shared n8n isolated workflow routing (requires PLATFORM_SHARED_N8N_SIGNING_SECRET).
PLATFORM_SHARED_N8N_BASE_URL=""

# [OPTIONAL] PLATFORM_SHARED_N8N_SIGNING_SECRET
# - Required: Optional (required ONLY when PLATFORM_SHARED_N8N_BASE_URL is configured).
# - Expected format: At least 64 hexadecimal characters (0-9, a-f), even length (>= 32 random bytes / 256 bits of entropy), or empty string.
# - How to generate: openssl rand -hex 32
# - Safe to leave blank: Yes when PLATFORM_SHARED_N8N_BASE_URL is blank. Shared n8n stays disabled unless both are valid.
# - Dependent features: X-TaskAI-Platform-Signature HMAC-SHA256 authentication on requests sent to a platform-shared n8n instance.
PLATFORM_SHARED_N8N_SIGNING_SECRET=""

# [OPTIONAL] PLATFORM_ADMIN_EMAILS
# - Required: Optional.
# - Expected format: Comma-separated email addresses (e.g., admin@example.com,secops@example.com), or empty string.
# - How to generate: List verified administrator account emails authorized to bind platform-shared n8n workflows.
# - Safe to leave blank: Yes. Leave blank if platform-shared n8n is unused or does not require an admin email allowlist.
# - Dependent features: Administrator allowlist enforcement for creating platform_shared n8n workflow integrations.
PLATFORM_ADMIN_EMAILS=""

# [OPTIONAL] Third-Party Native OAuth 2.0 Credentials (Slack, Microsoft Outlook & Teams)
# - Required: Optional (Slack also supports direct Bot Token connection without OAuth client credentials).
# - Safe to leave blank: Yes. When blank, 3P OAuth popups report missing client credentials honestly without fake states.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# [OPTIONAL] Additional Server-Side AI Provider Keys
# - Required: Optional (Built-in Gemini runtime is enabled by default via platform-managed GEMINI_API_KEY).
# - Safe to leave blank: Yes. Keys are read strictly on the server and never requested via browser inputs.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

